    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Kypelon.Pdf" Version="0.2.0-alpha.2" />
    <PackageReference Include="Kypelon.Pdf.AspNetCore" Version="0.2.0-alpha.2" />
  </ItemGroup>
</Project>
